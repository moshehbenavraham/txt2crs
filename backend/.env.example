# =============================================================================
# Backend Environment Configuration
# =============================================================================

# Domain
DOMAIN=localhost

# Frontend
FRONTEND_HOST=http://localhost:5183

# Environment: local, staging, production
ENVIRONMENT=local
ENABLE_PRIVATE_DEV_ROUTES=false
# Host-only developer mode may create local test accounts through /signup.
ENABLE_PUBLIC_SIGNUP=true

PROJECT_NAME=txt2crs
STACK_NAME=txt2crs

# Private txt2crs state for host-only local development.
# Docker Compose overrides these with the persistent container paths.
TXT2CRS_STATE_ROOT=/tmp/txt2crs-local
TXT2CRS_JOB_DB_PATH=/tmp/txt2crs-local/jobs.sqlite3
TXT2CRS_ARTIFACT_ROOT=/tmp/txt2crs-local/artifacts
TXT2CRS_CODEX_HOME=/tmp/txt2crs-local/codex-home
TXT2CRS_WORKER_ROOT=/tmp/txt2crs-worker

# Finite course-generation profile. Accepted jobs persist these exact values,
# so changing defaults affects only later submissions.
TXT2CRS_MODEL_ID=gpt-5.6
TXT2CRS_MAX_INPUT_BYTES=20971520
TXT2CRS_MAX_METADATA_BYTES=262144
TXT2CRS_MAX_NORMALIZED_CHARACTERS=200000
TXT2CRS_MAX_PDF_PAGES=200
TXT2CRS_ARTIFACT_MAX_JOB_BYTES=104857600
TXT2CRS_HTML_PREVIEW_MAX_BYTES=5242880
TXT2CRS_RETRY_MAXIMUM_ATTEMPTS=3
TXT2CRS_RETRY_BASE_SECONDS=1
TXT2CRS_RETRY_MAXIMUM_SECONDS=15
TXT2CRS_RETRY_JITTER_RATIO=0.2
TXT2CRS_RUN_MAXIMUM_TURNS=20
TXT2CRS_RUN_MAXIMUM_RESEARCH_CALLS=12
TXT2CRS_RUN_MAXIMUM_SEARCH_CALLS=6
TXT2CRS_RUN_MAXIMUM_EXTRACT_CALLS=6
TXT2CRS_RUN_MAXIMUM_SOURCES=12
TXT2CRS_RUN_MAXIMUM_EXTRACTED_BYTES=2000000
TXT2CRS_RUN_MAXIMUM_INPUT_TOKENS=600000
TXT2CRS_RUN_MAXIMUM_OUTPUT_TOKENS=150000
TXT2CRS_RUN_MAXIMUM_RETRIES=3
TXT2CRS_RUN_MAXIMUM_REPAIRS=3
TXT2CRS_RUN_MAXIMUM_ELAPSED_SECONDS=2700

# One serial worker reserves finite rolling-window capacity before acceptance.
TXT2CRS_ADMISSION_WINDOW_SECONDS=86400
TXT2CRS_ADMISSION_MAXIMUM_JOBS_PER_USER=2
TXT2CRS_ADMISSION_MAXIMUM_JOBS_GLOBAL=5
TXT2CRS_ADMISSION_MAXIMUM_RESERVED_TOKENS_PER_USER=1500000
TXT2CRS_ADMISSION_MAXIMUM_RESERVED_TOKENS_GLOBAL=3750000
TXT2CRS_ADMISSION_MAXIMUM_RESEARCH_MICROUSD_PER_USER=2000000
TXT2CRS_ADMISSION_MAXIMUM_RESEARCH_MICROUSD_GLOBAL=5000000

# Research remains unconfigured until an operator adds the secret locally.
# The MCP host must stay numeric loopback and is never published by Compose.
TXT2CRS_RESEARCH_ENABLED=true
TXT2CRS_RESEARCH_MCP_HOST=127.0.0.1
TXT2CRS_RESEARCH_MCP_PORT=8765
TXT2CRS_RESEARCH_MCP_STARTUP_TIMEOUT_SECONDS=10
TXT2CRS_RESEARCH_MCP_SHUTDOWN_TIMEOUT_SECONDS=10
# Durable discovery polls even when an in-process submission nudge is missed.
TXT2CRS_WORKER_POLL_SECONDS=2
TXT2CRS_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# Browser reads use this cache; only startup/maintenance runs real probes.
TXT2CRS_READINESS_REFRESH_SECONDS=60
TXT2CRS_READINESS_STALE_AFTER_SECONDS=120
TXT2CRS_READINESS_SHUTDOWN_TIMEOUT_SECONDS=30
# Device status routes read a shell cache; this monitor observes package memory.
TXT2CRS_AUTH_MONITOR_POLL_SECONDS=0.5
TXT2CRS_AUTH_SHUTDOWN_TIMEOUT_SECONDS=10
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=20

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5183,http://localhost:5184,https://localhost,https://localhost:5183,https://localhost:5184,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_BACKOFF_SECONDS=0.5

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5447
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Database pool tuning (optional overrides)
DB_POOL_PRE_PING=True
DB_POOL_SIZE=
DB_POOL_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=

SENTRY_DSN=
