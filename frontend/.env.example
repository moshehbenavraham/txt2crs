# =============================================================================
# HOST-ONLY FRONTEND DEVELOPMENT
# =============================================================================
# Copy this file to frontend/.env only when running Vite directly from
# frontend/. Docker Compose uses ../.env created from ../.env.example.
#
# Related templates:
# - ../.env.example is the canonical application and Docker configuration.
# - ../backend/.env.example is for direct FastAPI development.
#
# VITE_* values are public browser configuration. Never put secrets here.

# API URL - points to the backend service
# For local Docker deployment: http://localhost:8016
# For direct host development: http://localhost:8016
VITE_API_URL=http://localhost:8016

# Display-only signup visibility. The backend ENABLE_PUBLIC_SIGNUP setting
# remains authoritative. Set both values false for invite-only use.
VITE_ENABLE_PUBLIC_SIGNUP=true

# Display-only HTML preview cap in bytes. The backend remains authoritative for
# artifact delivery and defaults to the matching 5 MiB bound.
VITE_HTML_PREVIEW_MAX_BYTES=5242880

# Mailcatcher for local email testing
MAILCATCHER_HOST=http://localhost:1084
