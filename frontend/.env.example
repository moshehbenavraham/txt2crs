# API URL - points to the backend service
# For local Docker deployment: http://localhost:8012
# For local dev server: http://localhost:8012
VITE_API_URL=http://localhost:8012

# Display-only signup visibility. The backend ENABLE_PUBLIC_SIGNUP setting
# remains authoritative and defaults to disabled.
VITE_ENABLE_PUBLIC_SIGNUP=false

# Mailcatcher for local email testing
MAILCATCHER_HOST=http://localhost:1081
