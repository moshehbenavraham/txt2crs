# =============================================================================
# Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and update the values as needed.

# Docker Images
DOCKER_IMAGE_BACKEND=txt2crs-backend
DOCKER_IMAGE_FRONTEND=txt2crs-frontend
TAG=latest

# Domain (use localhost for local development)
DOMAIN=localhost
STACK_NAME=txt2crs

# Frontend
FRONTEND_HOST=http://localhost:5183

# Environment: local, staging, production
ENVIRONMENT=local
ENABLE_PRIVATE_DEV_ROUTES=false

PROJECT_NAME=txt2crs

# Private txt2crs state uses image-owned, fixed container paths.
# docker-compose.yml pins /var/lib/txt2crs for persistent SQLite, artifacts,
# and Codex credentials, plus /tmp/txt2crs-worker for ephemeral work. Use the
# backend-specific example for configurable host-only development paths.

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5183,http://localhost:5184,http://localhost:8012,https://localhost,https://localhost:5183,https://localhost:5184,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (optional for local development)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_BACKOFF_SECONDS=0.5

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5447
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Database pool tuning (optional overrides)
DB_POOL_PRE_PING=True
DB_POOL_SIZE=
DB_POOL_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=

# Sentry (optional)
SENTRY_DSN=

# =============================================================================
# Coolify Deployment (optional - for production deployments)
# =============================================================================
# COOLIFY_API_TOKEN=  API token with write/deploy/read permissions
COOLIFY_API_TOKEN=
# COOLIFY_API_URL=    Base URL (e.g., https://coolify.domain.com/api/v1)
COOLIFY_API_URL=
# GITHUB_REPO=        Repository URL (ex: moshehbenavraham/base_agent)
GITHUB_REPO=
# GITHUB_BRANCH=      Branch to deploy (ex: main)
GITHUB_BRANCH=main
# APP_NAME=           Application name (ex: base-agent-ui)
APP_NAME=
# APP_DOMAIN=         Domain name (ex: baseagent.aiwithapex.com)
APP_DOMAIN=
# BACKEND_APP_UUID=   Set after initial deployment via coolify-deploy.sh --create
BACKEND_APP_UUID=
# FRONTEND_APP_UUID=  Set after initial deployment via coolify-deploy.sh --create
FRONTEND_APP_UUID=
