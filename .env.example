# =============================================================================
# CANONICAL APPLICATION AND DOCKER CONFIGURATION
# =============================================================================
# Copy this file to .env at the repository root, then run:
#   ./scripts/start-local.sh
#
# Host-only alternatives (not used by Docker Compose):
# - backend/.env.example -> backend/.env for direct FastAPI development.
# - frontend/.env.example -> frontend/.env for direct Vite development.
#
# Keep secrets only in ignored .env files. Never commit real credentials.

# Docker Images
DOCKER_IMAGE_BACKEND=txt2crs-backend
DOCKER_IMAGE_FRONTEND=txt2crs-frontend
TAG=latest

# Domain (use localhost for local development)
DOMAIN=localhost
STACK_NAME=txt2crs

# Host ports registered for txt2crs in the workstation PORT-MAP.md.
# Container-to-container traffic continues to use each service's standard
# internal port; these values control only listeners published on the host.
TRAEFIK_HTTP_PORT=86
TRAEFIK_HTTPS_PORT=8443
TRAEFIK_DASHBOARD_PORT=8102
POSTGRES_PORT=5450
BACKEND_PORT=8016
FRONTEND_PORT=5195
ADMINER_PORT=8103
MAILCATCHER_SMTP_PORT=1029
MAILCATCHER_WEB_PORT=1084
JAEGER_UI_PORT=16689
OTLP_GRPC_PORT=4324
OTLP_HTTP_PORT=4325
PLAYWRIGHT_REPORT_PORT=9327

# Frontend
FRONTEND_HOST=http://localhost:5195

# Environment: local, staging, production
ENVIRONMENT=local
ENABLE_PRIVATE_DEV_ROUTES=false
# Public registration is the product default. Set false for invite-only use.
ENABLE_PUBLIC_SIGNUP=true

PROJECT_NAME=txt2crs

# Private txt2crs state uses image-owned, fixed container paths.
# docker-compose.yml pins /var/lib/txt2crs for persistent SQLite, artifacts,
# and Codex credentials, plus /tmp/txt2crs-worker for ephemeral work. Use the
# backend-specific example for configurable host-only development paths.

# Course system
# The application keeps its established model as the default and requires that
# any operator override match an exact model reported by Codex. Add a Tavily
# secret when research should be ready.
TXT2CRS_MODEL_ID=gpt-5.6-sol
TXT2CRS_RESEARCH_ENABLED=true

# Optional alternative to ChatGPT device authentication. Keep empty when the
# operator connects ChatGPT through the protected setup page.
OPENAI_API_KEY=

# Reference local capacity. Each job reserves up to 750,000 tokens and
# 1,000,000 micro-USD of research allowance inside this rolling window.
TXT2CRS_ADMISSION_WINDOW_SECONDS=86400
TXT2CRS_ADMISSION_MAXIMUM_JOBS_PER_USER=10
TXT2CRS_ADMISSION_MAXIMUM_JOBS_GLOBAL=20
TXT2CRS_ADMISSION_MAXIMUM_RESERVED_TOKENS_PER_USER=7500000
TXT2CRS_ADMISSION_MAXIMUM_RESERVED_TOKENS_GLOBAL=15000000
TXT2CRS_ADMISSION_MAXIMUM_RESEARCH_MICROUSD_PER_USER=10000000
TXT2CRS_ADMISSION_MAXIMUM_RESEARCH_MICROUSD_GLOBAL=20000000
TAVILY_API_KEY=

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5195,http://localhost:5196,http://localhost:5197,http://localhost:8016,https://localhost,https://localhost:8443,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (optional for local development)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_BACKOFF_SECONDS=0.5

# Postgres
POSTGRES_SERVER=db
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Database pool tuning (optional overrides)
DB_POOL_PRE_PING=True
DB_POOL_SIZE=
DB_POOL_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=

# Sentry (optional)
SENTRY_DSN=
