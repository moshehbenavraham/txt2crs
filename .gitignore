# Python bytecode and interpreter caches
__pycache__/
*.py[cod]

# Python tooling caches and reports
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
htmlcov/

# Local virtual environments
.venv/
venv/

# Python package build output
build/
dist/
*.egg-info/

# Node dependencies and frontend test output
node_modules/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local environment files may contain credentials.
.env
.env.*
!.env.example

# Temporary standalone authentication state contains Codex OAuth credentials.
.txt2crs-system/

# Local snapshot of python-react-boilerplate; reference only, never committed.
boilerplate/

# Scratch/example working directories
EXAMPLE/
EXAMPLE_CODE/

# Common operating-system and editor files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
