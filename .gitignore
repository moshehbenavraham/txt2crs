# Python bytecode and interpreter caches
__pycache__/
*.py[cod]

# Python tooling caches and reports
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
htmlcov/

# Local virtual environments
.venv/
venv/

# Python package build output
build/
dist/
*.egg-info/

# These three HTML files are required FastAPI runtime assets, not disposable
# package build output. A clean checkout must be able to render account emails
# without relying on an ignored developer-workspace artifact.
!/backend/app/email-templates/build/
!/backend/app/email-templates/build/*.html

# Node dependencies and frontend test output
node_modules/
frontend/.tanstack/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local environment files may contain credentials.
.env
.env.*
!.env.example

# Temporary standalone authentication state contains Codex OAuth credentials.
.txt2crs-system/

# Local backup bundles contain database records and Codex credentials.
/backups/

# Release proof may create authenticated runtime state, raw artifact downloads,
# browser traces, and provider-backed intermediate evidence. Only the reviewed
# redacted documents under docs/release are committed.
/.release-private/
/docs/release/private/
/docs/release/raw/
/docs/release/*.private.json
/docs/release/*.private.md

# Local snapshot of python-react-boilerplate; reference only, never committed.
boilerplate/

# Scratch/example working directories
EXAMPLE/
EXAMPLE_CODE/

# Common operating-system and editor files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
